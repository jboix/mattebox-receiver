{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["app/src/main.ts", "scripts/*.mjs", "scripts/spike/*.mjs", "test/e2e/**/*.ts"],
      "project": ["app/src/**/*.ts", "scripts/**/*.mjs", "test/**/*.ts", "*.ts"],
      "ignoreDependencies": ["@semantic-release/git", "semantic-release-monorepo"]
    },
    "packages/cast-receiver": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/cast-playground": {
      "entry": [
        "src/cli.ts",
        "src/server.ts",
        "ui/src/main.ts",
        "dev.mjs",
        "vite.config.ts",
        "platform.js"
      ],
      "project": ["src/**/*.ts", "ui/src/**/*.ts", "test/**/*.ts", "*.{ts,mjs,js}"]
    }
  }
}
