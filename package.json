{
  "name": "mattebox-receiver",
  "version": "0.0.0",
  "description": "Workspace for @mattebox/cast-receiver and its demo receiver page",
  "private": true,
  "author": "Josep Boix Requesens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jboix/mattebox-receiver.git"
  },
  "homepage": "https://github.com/jboix/mattebox-receiver#readme",
  "bugs": {
    "url": "https://github.com/jboix/mattebox-receiver/issues"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/cast-receiver",
    "packages/cast-playground"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "verify": "npm run lint && npm run docs:check && npm run typecheck && npm run depcruise && npm run knip && npm run build && npm run check:emit && npm run check:side-effects && npx size-limit && npm run check:size-chart && npm run check:package && npm run test",
    "build": "npm run build --workspaces",
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise packages/*/src",
    "knip": "knip",
    "test": "vitest run",
    "test:node": "vitest run --project=node",
    "test:browser": "vitest run --project=\"browser*\"",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check:emit": "node scripts/check-emit.mjs",
    "check:side-effects": "node scripts/side-effect-audit.mjs",
    "check:package": "npm run check:package --workspaces",
    "check:size-chart": "npm run size-chart && git diff --exit-code --stat -- docs/size-chart-*.svg",
    "playground": "node packages/cast-playground/dev.mjs",
    "size-chart": "node scripts/size-chart.mjs",
    "app": "vite app",
    "app:build": "vite build app",
    "docs:check": "remark . --quiet --frail --use ./scripts/remark-check-formatted.mjs",
    "docs:format": "remark . --quiet --output"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@mattebox/player": "^0.6.0",
    "@mattebox/player-core": "^0.3.0",
    "@semantic-release/git": "11.0.1",
    "@size-limit/esbuild": "^14.0.0",
    "@size-limit/file": "^14.0.0",
    "@types/node": "^24.13.4",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dependency-cruiser": "^18.2.0",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "mattebox": "^0.6.1",
    "playwright": "^1.62.1",
    "publint": "^0.3.24",
    "remark-cli": "^12.0.1",
    "remark-gfm": "^4.0.1",
    "remark-validate-links": "^13.1.0",
    "rolldown": "^1.2.8",
    "semantic-release": "25.0.9",
    "semantic-release-monorepo": "^8.0.2",
    "size-limit": "^14.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
