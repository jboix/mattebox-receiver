{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    // Waives two bugs in vitest 5.0.0's own types: a missing `@vitest/expect`
    // import and a benchmark option that exactOptionalPropertyTypes rejects.
    // Drop it once `tsc --noEmit` stays green without it.
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmitHelpers": true,
    "importHelpers": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Typecheck, tests and the app resolve the library to its sources, so
    // none needs a build first. The package build config resets this.
    "paths": {
      "@mattebox/cast-receiver": ["./packages/cast-receiver/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "app",
    "packages/cast-playground/ui",
    "test",
    "vitest.config.ts",
    "vitest.e2e.config.ts",
    "vitest.alias.ts"
  ],
  "exclude": ["app/dist"]
}
